<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><ApplicationIcon>../RFloor/Assets/RFloor.ico</ApplicationIcon><SelfContained Condition="'$(RuntimeIdentifier)'!=''">true</SelfContained><PublishTrimmed>false</PublishTrimmed></PropertyGroup>
 <ItemGroup><ProjectReference Include="../RFloor/RFloor.csproj"/><PackageReference Include="Avalonia.Desktop" Version="12.1.6"/></ItemGroup>
 <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) Or ('$(RuntimeIdentifier)'=='' And $([MSBuild]::IsOSPlatform('Windows')))"><Content Include="../../build/native/windows/iperf3/**/*" Link="iperf3/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
 <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))"><Content Include="../../build/native/linux/iperf3" Link="iperf3/iperf3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="../../build/native/licenses/*" Link="iperf3/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
 <Target Name="RequireBundledIperf" BeforeTargets="Publish"><Error Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) And !Exists('../../build/native/windows/iperf3/iperf3.exe')" Text="Run build/Prepare-Iperf.ps1 before publishing."/><Error Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) And !Exists('../../build/native/linux/iperf3')" Text="Run bash build/iperf/build.sh linux before publishing."/></Target>
</Project>
