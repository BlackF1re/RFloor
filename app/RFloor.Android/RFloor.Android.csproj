<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-android</TargetFramework><SupportedOSPlatformVersion>26</SupportedOSPlatformVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><ApplicationId>io.github.blackf1re.rfloor</ApplicationId><ApplicationTitle>RFloor</ApplicationTitle><ApplicationVersion>5001</ApplicationVersion><ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion><AndroidPackageFormats>apk</AndroidPackageFormats><AndroidEnableProfiledAot>false</AndroidEnableProfiledAot><RunAOTCompilation>false</RunAOTCompilation><PublishTrimmed>false</PublishTrimmed><AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods><RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers></PropertyGroup>
 <PropertyGroup Condition="'$(EnablePlatformChecks)' == 'true'"><DefineConstants>$(DefineConstants);RFLOOR_PLATFORM_CHECKS</DefineConstants></PropertyGroup>
 <ItemGroup Condition="'$(EnablePlatformChecks)' == 'true'"><Compile Include="../../tests/RFloor.Android.Checks/PlatformChecks.cs" Link="PlatformChecks.cs"/></ItemGroup>
 <ItemGroup><PackageReference Include="Avalonia.Android" Version="12.1.6"/><ProjectReference Include="../RFloor/RFloor.csproj"/><AndroidNativeLibrary Include="../../build/native/android/arm64-v8a/librfloor_iperf.so" Condition="Exists('../../build/native/android/arm64-v8a/librfloor_iperf.so')"/><AndroidNativeLibrary Include="../../build/native/android/x86_64/librfloor_iperf.so" Condition="Exists('../../build/native/android/x86_64/librfloor_iperf.so')"/></ItemGroup>
 <ItemGroup><AndroidAsset Include="../../build/native/licenses/*" Link="licenses/%(Filename)%(Extension)"/></ItemGroup>
 <Target Name="RequireBundledIperf" BeforeTargets="Publish"><Error Condition="!Exists('../../build/native/android/arm64-v8a/librfloor_iperf.so') Or !Exists('../../build/native/android/x86_64/librfloor_iperf.so')" Text="Run bash tools/iperf/build.sh android before publishing."/></Target>
</Project>
