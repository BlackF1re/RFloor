<local:SurfaceWindow xmlns:local="using:RFloor" xmlns:c="using:RFloor.Controls" x:Class="RFloor.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#FFFFFF" KeyDown="Window_KeyDown">
 <Grid><DockPanel x:Name="Workspace">
  <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="12,4">
   <c:MenuItem Header="{DynamicResource UI_0}">
    <c:MenuItem Header="{DynamicResource UI_1}" InputGesture="Ctrl+N" Click="New_Click" Tag="new" />
    <c:MenuItem Header="{DynamicResource UI_2}" InputGesture="Ctrl+Shift+N" Click="NewSurvey_Click" Tag="survey" /><c:MenuItem Header="{DynamicResource UI_3}" InputGesture="Ctrl+W" Click="CloseTab_Click" Tag="close" /><Separator /><c:MenuItem Header="{DynamicResource UI_4}" InputGesture="Ctrl+O" Click="Open_Click" Tag="open" />
    <c:MenuItem Header="{DynamicResource UI_5}" InputGesture="Ctrl+S" Click="Save_Click" Tag="save" />
    <c:MenuItem Header="{DynamicResource UI_6}" InputGesture="Ctrl+Shift+S" Click="SaveAs_Click" Tag="saveAs" />
    <Separator /><c:MenuItem Header="{DynamicResource UI_7}" Click="ExportImage_Click" />
   </c:MenuItem>
   <c:MenuItem Header="{DynamicResource UI_8}">
    <c:MenuItem Header="{DynamicResource UI_9}" InputGesture="Ctrl+Z" Click="Undo_Click" Tag="undo" /><c:MenuItem Header="{DynamicResource UI_10}" InputGesture="Ctrl+Y" Click="Redo_Click" Tag="redo" />
    <Separator /><c:MenuItem Header="{DynamicResource UI_11}" InputGesture="Ctrl+A" Click="SelectAll_Click" Tag="all" /><c:MenuItem Header="{DynamicResource UI_12}" InputGesture="F2" Click="Rename_Click" Tag="rename" /><c:MenuItem Header="{DynamicResource UI_13}" InputGesture="Delete" Click="DeleteSelection_Click" Tag="delete" />
   </c:MenuItem>
   <c:MenuItem Header="{DynamicResource UI_14}"><c:MenuItem Header="{DynamicResource UI_15}" InputGesture="Ctrl+D0" Click="Fit_Click" Tag="fit" /><Separator /><c:MenuItem Header="{DynamicResource UI_16}" Click="EditMode_Click" /><c:MenuItem Header="{DynamicResource UI_17}" Click="SurveyMode_Click" /><Separator /><c:MenuItem Header="{DynamicResource UI_18}" Click="ZoomIn_Click" Tag="zoomIn" /><c:MenuItem Header="{DynamicResource UI_19}" Click="ZoomOut_Click" Tag="zoomOut" /></c:MenuItem>
   <c:MenuItem x:Name="SettingsMenu" Header="{DynamicResource UI_20}"><c:MenuItem Header="{DynamicResource UI_21}" InputGesture="Ctrl+OemComma" Click="Preferences_Click" Tag="settings" /><c:MenuItem Header="{DynamicResource UI_22}" Click="Shortcuts_Click" /></c:MenuItem>
  </Menu>
  <DockPanel DockPanel.Dock="Top" Background="#EEEEEE" Margin="8,4,8,0">
   <c:Button DockPanel.Dock="Right" Content="＋" ToolTip.Tip="{DynamicResource UI_23}" Click="New_Click" Width="32" Margin="4,0,0,0" Padding="0" />
   <TabControl x:Name="DocumentTabs" SelectionChanged="DocumentTabs_SelectionChanged" BorderThickness="0" Background="Transparent">
    <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></TabControl.ItemsPanel>
    <TabControl.Template><ControlTemplate><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></ScrollViewer></ControlTemplate></TabControl.Template>
   </TabControl>
  </DockPanel>
  <c:Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="White" BorderBrush="#DEDEDE" BorderThickness="0,1,0,0" Padding="12,4"><DockPanel><c:TextBlock DockPanel.Dock="Right" Text="{DynamicResource UI_26}" Foreground="#707070" /><c:TextBlock x:Name="Status" Text="{DynamicResource UI_27}" Foreground="#707070" /></DockPanel></c:Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <c:Border x:Name="LeftSidebar" Width="240" ClipToBounds="True" Background="#FFFFFF" BorderBrush="#DEDEDE" BorderThickness="0,0,1,0" Padding="14"><c:ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><StackPanel x:Name="EditorPanel">
    <c:TextBlock Text="{DynamicResource UI_28}" FontSize="20" FontWeight="SemiBold" /><c:TextBlock Text="{DynamicResource UI_29}" Foreground="#707070" Margin="0,5,0,20" TextWrapping="Wrap" />
    <c:TextBlock Text="{DynamicResource UI_30}" FontSize="10" FontWeight="Bold" Foreground="#707070" Margin="0,0,0,12" />
    <c:TextBlock Text="{DynamicResource UI_31}" /><c:TextBox x:Name="RoomName" Text="{DynamicResource UI_32}" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><c:TextBlock Text="{DynamicResource UI_33}" /><c:TextBox x:Name="RoomX" Text="0" /></StackPanel><StackPanel Grid.Column="2"><c:TextBlock Text="{DynamicResource UI_34}" /><c:TextBox x:Name="RoomY" Text="0" /></StackPanel></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><c:TextBlock Text="{DynamicResource UI_35}" /><c:TextBox x:Name="RoomWidth" Text="4" /></StackPanel><StackPanel Grid.Column="2"><c:TextBlock Text="{DynamicResource UI_36}" /><c:TextBox x:Name="RoomHeight" Text="3" /></StackPanel></Grid>
    <c:TextBox x:Name="Thickness" IsVisible="False" TextChanged="SettingsChanged" Text="0,14" />
    <c:TextBlock Text="{DynamicResource UI_37}" TextWrapping="Wrap" Foreground="#707070" Margin="0,0,0,12" /><c:TextBox x:Name="DoorWidth" IsVisible="False" TextChanged="SettingsChanged" Text="0,9" />
    <c:Button Content="{DynamicResource UI_38}" Click="AddRoom_Click" Background="#C45100" Foreground="White" Margin="0,4,0,16" />
    <CheckBox x:Name="SnapEnabled" Content="{DynamicResource UI_39}" ToolTip.Tip="{DynamicResource UI_40}" IsChecked="True" Margin="0,0,0,8" />
   </StackPanel><StackPanel x:Name="SurveyPanel" IsVisible="False">
    <c:TextBlock Text="{DynamicResource UI_41}" FontSize="20" FontWeight="SemiBold" /><c:TextBlock Text="{DynamicResource UI_42}" Foreground="#707070" TextWrapping="Wrap" Margin="0,5,0,20" />
    <c:TextBlock Text="{DynamicResource UI_43}" TextWrapping="Wrap" Foreground="#707070" Margin="0,0,0,16" />
    <c:TextBlock Text="{DynamicResource UI_MultiBandSurvey}" TextWrapping="Wrap" Foreground="#707070" Margin="0,0,0,16" />
    <c:TextBlock Text="{DynamicResource UI_44}" FontSize="10" FontWeight="Bold" Foreground="#707070" /><ComboBox x:Name="BandPicker" SelectedIndex="1" SelectionChanged="SurveyView_Changed" Margin="0,7,0,16" Padding="8"><ComboBoxItem Content="{DynamicResource UI_45}" Tag="2.4" /><ComboBoxItem Content="{DynamicResource UI_46}" Tag="5" /><ComboBoxItem Content="{DynamicResource UI_47}" Tag="6" /></ComboBox>
    <c:TextBlock Text="{DynamicResource UI_48}" FontSize="10" FontWeight="Bold" Foreground="#707070" /><ComboBox x:Name="AccessPointPicker" SelectionChanged="AccessPoint_Changed" Margin="0,7,0,16" Padding="8" />
    <SplitButton x:Name="LayerPicker" Click="NextLayer_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="44" Margin="0,0,0,10">
     <TextBlock x:Name="LayerLabel" TextTrimming="CharacterEllipsis" />
     <SplitButton.Flyout><MenuFlyout /></SplitButton.Flyout>
    </SplitButton>
    <c:TextBlock x:Name="HeatLegend" TextWrapping="Wrap" Foreground="#707070" FontSize="11" Margin="0,0,0,16" />
    <c:TextBlock Text="{DynamicResource UI_CoverageRadius}" TextWrapping="Wrap" />
    <NumericUpDown x:Name="CoverageRadiusInput" Minimum="0.5" Maximum="30" Increment="0.5" Value="4.5" FormatString="0.##" ValueChanged="CoverageRadius_Changed" Margin="0,6,0,12" />
    <c:TextBlock x:Name="NetworkStatus" Text="{DynamicResource UI_55}" TextWrapping="Wrap" Foreground="#707070" Margin="0,0,0,16" />
    <c:TextBlock Text="{DynamicResource UI_56}" TextWrapping="Wrap" Foreground="#707070" FontSize="11" />
   </StackPanel>
   <StackPanel x:Name="MeasurementSettingsPanel" IsVisible="False">
    <c:TextBlock Text="{DynamicResource UI_57}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
    <c:TextBlock Text="{DynamicResource UI_58}" TextWrapping="Wrap" Foreground="#707070" Margin="0,0,0,16" />
    <CheckBox x:Name="RunSignal" Content="{DynamicResource UI_59}" IsChecked="True" IsCheckedChanged="SettingsChanged" Margin="0,0,0,10" />
    <CheckBox x:Name="RunPing" Content="{DynamicResource UI_60}" IsChecked="True" IsCheckedChanged="SettingsChanged" Margin="0,0,0,10" />
    <CheckBox x:Name="RunIperf" Content="{DynamicResource UI_61}" IsChecked="True" IsCheckedChanged="SettingsChanged" Margin="0,0,0,10" />
    <CheckBox x:Name="RunUpload" Content="{DynamicResource UI_62}" IsChecked="True" IsCheckedChanged="SettingsChanged" Margin="0,0,0,18" />
    <GroupBox Header="Ping" Margin="0,0,0,12"><StackPanel Margin="12,8">
     <c:TextBlock Text="{DynamicResource UI_63}" /><c:TextBox x:Name="PingTargets" Text="1.1.1.1, 8.8.8.8" TextChanged="SettingsChanged" />
     <c:TextBlock Text="{DynamicResource UI_64}" /><c:TextBox x:Name="PingCount" Text="4" TextChanged="SettingsChanged" />
    </StackPanel></GroupBox>
    <GroupBox Header="{DynamicResource UI_65}" Margin="0,0,0,12"><StackPanel Margin="12,8">
     <c:TextBlock Text="{DynamicResource UI_66}" /><c:TextBox x:Name="IperfHost" Text="192.168.2.1" TextChanged="SettingsChanged" />
     <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel><c:TextBlock Text="{DynamicResource UI_67}" /><c:TextBox x:Name="IperfPort" Text="5201" TextChanged="SettingsChanged" /></StackPanel>
      <StackPanel Grid.Column="2"><c:TextBlock Text="{DynamicResource UI_68}" /><c:TextBox x:Name="IperfDuration" Text="5" TextChanged="SettingsChanged" /></StackPanel>
     </Grid>
    </StackPanel></GroupBox>
    <c:TextBlock Text="{DynamicResource UI_69}" /><c:TextBox x:Name="NetworkRefresh" Text="5" TextChanged="SettingsChanged" />
   </StackPanel></Grid></c:ScrollViewer></c:Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <c:Border x:Name="EditorRibbon" Background="White" BorderBrush="#DEDEDE" BorderThickness="0,0,0,1" Padding="8,5">
     <DockPanel>
      <c:Border DockPanel.Dock="Left"><c:ToggleButton x:Name="ModeSwitch" Classes="modeSwitch" Width="144" Height="36" Padding="4" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" Click="ModeSwitch_Click" Margin="0,0,8,0" Cursor="Hand">
 <Grid Height="28" ColumnDefinitions="*,*"><c:Border x:Name="ModeThumb" Grid.ColumnSpan="2" Width="68" HorizontalAlignment="Left" Background="#C45100" CornerRadius="10"><c:Border.RenderTransform><TranslateTransform /></c:Border.RenderTransform></c:Border><c:TextBlock x:Name="ModePlanText" Grid.Column="1" Text="{DynamicResource UI_ModePlan}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/><c:TextBlock x:Name="ModeSurveyText" Text="{DynamicResource UI_ModeSurvey}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></c:ToggleButton></c:Border>
      <c:Border DockPanel.Dock="Right" BorderBrush="#DEDEDE" BorderThickness="1,0,0,0" Padding="6,0,0,0" Margin="6,0,0,0" VerticalAlignment="Center">
       <Panel>
        <StackPanel x:Name="HistoryTools" Orientation="Horizontal"><c:Button Content="↶" Width="28" Height="32" Padding="0" Margin="0,0,2,0" ToolTip.Tip="{DynamicResource UI_72}" Click="Undo_Click" /><c:Button Content="↷" Width="28" Height="32" Padding="0" Margin="0" ToolTip.Tip="{DynamicResource UI_73}" Click="Redo_Click" /></StackPanel>
        <c:Button x:Name="MeasureButton" Content="{DynamicResource UI_CancelMeasurement}" Click="Measure_Click" IsVisible="False" Height="32" Padding="8,0" Margin="0" />
       </Panel>
      </c:Border>
      <c:ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <StackPanel x:Name="DrawingToolGroup" Orientation="Horizontal"><c:Button x:Name="SelectTool" Tag="select" Click="Tool_Click" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 3,2 L 3,22 8,16 13,24 17,22 12,14 21,14 Z" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_74}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="RoomTool" Tag="room" Click="Tool_Click" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 2,2 L 22,2 22,22 15,22 M 9,22 L 2,22 2,2 M 9,22 L 9,16 Q 15,16 15,22" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_75}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="WallTool" Tag="wall" Click="Tool_Click" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 2,7 L 22,7 M 2,17 L 22,17 M 8,7 L 8,17 M 17,7 L 17,17" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_76}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="DoorTool" Tag="door" Click="Tool_Click" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 2,2 L 2,22 M 22,2 L 22,22 M 2,22 L 2,3 Q 21,3 21,22 M 2,22 L 21,22" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_77}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="RectangleTool" Tag="rect" Click="Tool_Click" ToolTip.Tip="{DynamicResource UI_78}" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 2,5 L 22,5 22,19 2,19 Z" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_79}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="RoundedRectangleTool" Tag="roundRect" Click="Tool_Click" ToolTip.Tip="{DynamicResource UI_80}" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 6,4 L 18,4 Q 22,4 22,8 L 22,16 Q 22,20 18,20 L 6,20 Q 2,20 2,16 L 2,8 Q 2,4 6,4 Z" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_81}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="EllipseTool" Tag="ellipse" Click="Tool_Click" ToolTip.Tip="{DynamicResource UI_82}" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 22,12 A 10,7 0 1 1 2,12 A 10,7 0 1 1 22,12" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_83}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="LineTool" Tag="line" Click="Tool_Click" ToolTip.Tip="{DynamicResource UI_84}" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 3,21 L 21,3 M 1,21 L 5,21 M 21,1 L 21,5" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_85}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="TextTool" Tag="text" Click="Tool_Click" ToolTip.Tip="{DynamicResource UI_86}" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 3,4 L 21,4 M 12,4 L 12,22 M 7,22 L 17,22" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_87}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="RouterTool" Tag="router" Click="Tool_Click" ToolTip.Tip="{DynamicResource UI_88}" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Image Width="20" Height="20" x:Name="RouterToolImage" /><c:TextBlock Text="{DynamicResource UI_89}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button><c:Button x:Name="TapeTool" Tag="tape" Click="Tool_Click" Width="50" Height="50" Padding="2" Margin="0,0,2,0"><StackPanel><Path Data="M 2,6 L 22,6 22,18 2,18 Z M 6,6 L 6,12 M 10,6 L 10,10 M 14,6 L 14,12 M 18,6 L 18,10" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_90}" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel></c:Button></StackPanel>
        <StackPanel x:Name="SurveyTools" Orientation="Horizontal" Spacing="3">
         <c:ToggleButton x:Name="SelectPointsTool" Tag="Select" Classes="surveyTool" Width="54" Click="SurveyTool_Click" AutomationProperties.Name="{DynamicResource UI_PointSelect}">
          <StackPanel Spacing="4"><Path Data="M 2,7 L 2,2 7,2 M 13,2 L 18,2 18,7 M 18,13 L 18,18 13,18 M 7,18 L 2,18 2,13" Width="18" Height="18" Stretch="Uniform" Stroke="#171717" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_PointSelect}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
         </c:ToggleButton>
         <c:ToggleButton x:Name="AddPointTool" Tag="Add" Classes="surveyTool" Width="54" Click="SurveyTool_Click" AutomationProperties.Name="{DynamicResource UI_PointAdd}">
          <StackPanel Spacing="4"><Path Data="M 10,2 L 10,18 M 2,10 L 18,10" Width="18" Height="18" Stretch="Uniform" Stroke="#171717" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_PointAdd}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
         </c:ToggleButton>
         <c:ToggleButton x:Name="DeletePointsTool" Tag="Delete" Classes="surveyTool" Width="54" Click="SurveyTool_Click" AutomationProperties.Name="{DynamicResource UI_PointDelete}">
          <StackPanel Spacing="4"><Path Data="M 2,10 L 18,10" Width="18" Height="18" Stretch="None" Stroke="#171717" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_PointDelete}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
         </c:ToggleButton>
         <c:ToggleButton x:Name="RepeatPointTool" Tag="Repeat" Classes="surveyTool" Width="75" Click="SurveyTool_Click" AutomationProperties.Name="{DynamicResource UI_PointRepeat}">
          <StackPanel Spacing="2"><Path Data="M 15,5 A 7,7 0 1 0 17,11 M 15,1 L 15,6 10,6" Width="18" Height="18" Stretch="Uniform" Stroke="#171717" StrokeThickness="1.5" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_PointRepeatCaption}" FontSize="10" LineHeight="11" TextAlignment="Center" HorizontalAlignment="Center"/></StackPanel>
         </c:ToggleButton>
        </StackPanel>
        <c:TextBlock x:Name="ToolHint" IsVisible="False" />
       </StackPanel>
      </c:ScrollViewer>
     </DockPanel>
    </c:Border>
    <c:Border Grid.Row="2" Background="White" BorderBrush="#DEDEDE" BorderThickness="0,1,0,0" Padding="8,3">
     <DockPanel x:Name="CanvasDock" Height="28" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4"><c:TextBlock Text="{DynamicResource UI_93}" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox x:Name="GridPicker" SelectedIndex="1" SelectionChanged="GridChanged" Height="28" VerticalContentAlignment="Center" Margin="0" Padding="5,0"><ComboBoxItem Content="0,05" Tag="0.05" /><ComboBoxItem Content="0,1" Tag="0.1" /><ComboBoxItem Content="0,25" Tag="0.25" /><ComboBoxItem Content="0,5" Tag="0.5" /><ComboBoxItem Content="1" Tag="1" /></ComboBox><c:Button x:Name="GridViewButton" Content="▦" Click="GridView_Click" ToolTip.Tip="{DynamicResource UI_94}" /></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><c:Button Content="{DynamicResource UI_95}" ToolTip.Tip="{DynamicResource UI_96}" Click="Fit_Click" /><c:Button Content="−" ToolTip.Tip="{DynamicResource UI_97}" Click="ZoomOut_Click" /><c:TextBlock x:Name="ZoomLabel" Text="100 %" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" /><c:Button Content="+" ToolTip.Tip="{DynamicResource UI_98}" Click="ZoomIn_Click" /></StackPanel>
     </DockPanel>
    </c:Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <c:Button x:Name="RulerModeButton" Grid.Column="2" Width="24" Height="24" Margin="0" Padding="0" Click="CycleRuler_Click" ToolTip.Tip="{DynamicResource UI_99}" />
    <c:Canvas x:Name="RulerTop" Grid.Column="1" Height="24" Background="#F5F5F5" ClipToBounds="True" /><c:Canvas x:Name="RulerBottom" Grid.Row="2" Grid.Column="1" Height="24" Background="#F5F5F5" ClipToBounds="True" /><c:Canvas x:Name="RulerLeft" Grid.Row="1" Width="24" Background="#F5F5F5" ClipToBounds="True" /><c:Canvas x:Name="RulerRight" Grid.Row="1" Grid.Column="2" Width="24" Background="#F5F5F5" ClipToBounds="True" />
    <Grid Grid.Row="1" Grid.Column="1">    <c:ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#EEEEEE" ScrollChanged="Viewport_ScrollChanged" SizeChanged="Viewport_SizeChanged" PointerMoved="Viewport_PointerMove" PointerExited="Viewport_PointerLeave" ><c:Border x:Name="PlanSurface" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top"><LayoutTransformControl x:Name="ZoomHost"><LayoutTransformControl.LayoutTransform><ScaleTransform  ScaleX="1" ScaleY="1" /></LayoutTransformControl.LayoutTransform><c:Canvas x:Name="Plan" UseLayoutRounding="False" Width="2400" Height="1800" Background="#FFFFFF" PointerPressed="Plan_MouseDown" PointerMoved="Plan_MouseMove" PointerReleased="Plan_MouseUp"></c:Canvas></LayoutTransformControl></c:Border></c:ScrollViewer><c:Canvas x:Name="ProjectionOverlay" IsHitTestVisible="False" ClipToBounds="True" /></Grid></Grid><c:Border x:Name="EmptyPlan" Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#DEDEDE" BorderThickness="1" CornerRadius="12" Padding="28,22"><StackPanel><c:TextBlock Text="{DynamicResource UI_100}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" /><c:TextBlock Text="{DynamicResource UI_101}" Foreground="#707070" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,8,0,0" /></StackPanel></c:Border>
    <Panel x:Name="CanvasPanelTabs" Grid.Row="1" ZIndex="110">
     <c:Button x:Name="LeftPanelButton" Click="ToggleLeftPanel_Click" Width="24" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0" Margin="0" Background="#F2F2F2" BorderBrush="#CBCBCB" BorderThickness="0,1,1,1" CornerRadius="0,6,6,0">
      <Path Width="11" Height="14" Stroke="#454545" StrokeThickness="1.75" />
     </c:Button>
     <c:Button x:Name="RightPanelButton" Click="ToggleRightPanel_Click" Width="24" Height="46" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Margin="0" Background="#F2F2F2" BorderBrush="#CBCBCB" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
      <Path Width="11" Height="14" Stroke="#454545" StrokeThickness="1.75" />
     </c:Button>
    </Panel>
   </Grid>
   <c:Border x:Name="RightSidebar" Width="250" ClipToBounds="True" Grid.Column="2" Background="White" BorderBrush="#DEDEDE" BorderThickness="1,0,0,0" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><c:Button x:Name="DeleteButton" Content="{DynamicResource UI_103}" Click="DeleteSelection_Click" IsEnabled="False" Margin="0" /></StackPanel><c:ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><c:TextBlock Text="{DynamicResource UI_104}" FontSize="10" FontWeight="Bold" Foreground="#707070" /><c:TextBox x:Name="ProjectName" TextChanged="SettingsChanged" Text="{DynamicResource UI_105}" LostFocus="ProjectName_LostFocus" ToolTip.Tip="{DynamicResource UI_106}" /><c:TextBlock x:Name="ObjectHeading" Text="{DynamicResource UI_107}" FontSize="18" FontWeight="SemiBold" /><c:TextBlock x:Name="ObjectSubtitle" Text="{DynamicResource UI_108}" Foreground="#707070" Margin="0,5,0,16" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,8">
      <c:TextBox x:Name="ObjectSearch" PlaceholderText="{DynamicResource UI_ObjectSearch}" AutomationProperties.Name="{DynamicResource UI_ObjectSearch}" TextChanged="ObjectSearch_Changed" Height="36" Margin="0" />
      <c:Button x:Name="ClearObjectSearch" Grid.Column="1" Click="ClearObjectSearch_Click" AutomationProperties.Name="{DynamicResource UI_ClearObjectSearch}" ToolTip.Tip="{DynamicResource UI_ClearObjectSearch}" Width="36" Height="36" Padding="0" Margin="0" IsEnabled="False">
       <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Width="16" Height="16" Stroke="#454545" StrokeThickness="1.5" />
      </c:Button>
     </Grid><ListBox x:Name="Objects" Height="145" SelectionMode="Multiple, Toggle" PointerPressed="Objects_Rename" SelectionChanged="Objects_SelectionChanged"  BorderBrush="#DEDEDE"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox><c:TextBlock Text="{DynamicResource UI_109}" FontSize="10" FontWeight="Bold" Foreground="#707070" Margin="0,24,0,4" /><c:TextBlock x:Name="SelectionInfo" Text="{DynamicResource UI_110}" TextWrapping="Wrap" Margin="0,10,0,14" Foreground="#707070" /><StackPanel x:Name="PropertiesEditor" IsVisible="False">
     <StackPanel x:Name="PropertyNamePanel"><c:TextBlock Text="{DynamicResource UI_111}" /><c:TextBox x:Name="PropertyName" /></StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><c:TextBlock x:Name="PropertyXLabel" Text="{DynamicResource UI_112}" /><c:TextBox x:Name="PropertyX" /></StackPanel><StackPanel Grid.Column="2"><c:TextBlock x:Name="PropertyYLabel" Text="{DynamicResource UI_113}" /><c:TextBox x:Name="PropertyY" /></StackPanel></Grid>
     <Grid x:Name="PropertySizePanel"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><c:TextBlock x:Name="PropertyWLabel" Text="{DynamicResource UI_114}" /><c:TextBox x:Name="PropertyW" /></StackPanel><StackPanel Grid.Column="2"><c:TextBlock x:Name="PropertyHLabel" Text="{DynamicResource UI_115}" /><c:TextBox x:Name="PropertyH" /></StackPanel></Grid>
     <StackPanel x:Name="PropertyThicknessPanel"><c:TextBlock Text="{DynamicResource UI_116}" /><c:TextBox x:Name="PropertyThickness" /></StackPanel>
     <c:TextBlock x:Name="PropertyHint" TextWrapping="Wrap" Foreground="#707070" FontSize="11" Margin="0,0,0,10" />
     <StackPanel x:Name="PropertyLabelPanel" Spacing="4" Margin="0,0,0,12" />
     <c:Button Content="{DynamicResource UI_117}" Click="ApplyProperties_Click" Background="#C45100" Foreground="White" Margin="0,0,0,12" />
    </StackPanel></StackPanel></c:ScrollViewer></DockPanel></c:Border>
  </Grid>
 </DockPanel>
 <c:Border x:Name="Welcome" Background="#F5F5F5" ZIndex="200">
  <c:Border Background="White" CornerRadius="16" Padding="64,48" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#DEDEDE" BorderThickness="1">
   <StackPanel Width="360"><Image Source="avares://RFloor/Assets/RFloor.png" Width="144" Height="144" Margin="0,0,0,24" />
    <c:TextBlock Text="RFloor" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <c:TextBlock Text="{DynamicResource UI_118}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#707070" Margin="0,12,0,28" />
    <c:Button Content="{DynamicResource UI_119}" Click="New_Click" Background="#C45100" Foreground="White" Margin="0,0,0,12" />
    <c:Button Content="{DynamicResource UI_120}" Click="Open_Click" Margin="0" />
   </StackPanel>
  </c:Border>
 </c:Border></Grid>
</local:SurfaceWindow>
